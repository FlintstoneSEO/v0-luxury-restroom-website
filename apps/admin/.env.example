# Browser-safe Supabase project URL and publishable/anon key for later admin authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only operational access. Not used by the foundation scaffold.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only email/provider values needed when corresponding admin APIs move.
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEMPLATE_ID=
DROPBOX_SIGN_TEST_MODE=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=

# Server-only distance calculations. Do not use NEXT_PUBLIC_ for this key.
GOOGLE_MAPS_API_KEY=

# Origins only, with no path/query/fragment. Set before link-generating APIs move.
ADMIN_APP_URL=
CUSTOMER_WORKFLOW_URL=
PUBLIC_SITE_URL=

# Root workflow deployment retains provider webhook secrets and callback URLs.
# Do not provision webhook secrets here unless callback ownership changes.
