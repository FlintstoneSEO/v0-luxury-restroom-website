---
import ButtonLink from '../ButtonLink.astro';

interface Props {
  eyebrow?: string | null;
  heading: string;
  body?: string | null;
  items?: { text: string }[];
  aside: {
    heading: string;
    body: string;
    label: string;
    href: string;
  };
}

const { eyebrow, heading, body, items = [], aside } = Astro.props;
---

<section class="section-space relative isolate overflow-hidden bg-midnight text-white">
  <div aria-hidden="true" class="absolute -left-40 top-1/2 -z-10 h-[34rem] w-[34rem] -translate-y-1/2 rounded-full border border-white/8"></div>
  <div class="content-shell grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
    <div>
      {eyebrow && (
        <p class="eyebrow" data-editable="text" data-type="text" data-prop="eyebrow">{eyebrow}</p>
      )}
      <h2 class="mt-5 font-serif text-5xl font-medium leading-[0.92] tracking-[-0.045em] text-balance md:text-6xl" data-editable="text" data-type="text" data-prop="heading">
        {heading}
      </h2>
      {body && (
        <p class="mt-7 max-w-2xl text-base leading-8 text-white/65" data-editable="text" data-type="text" data-prop="body">{body}</p>
      )}
      <ul class="mt-9 grid gap-x-8 gap-y-2 sm:grid-cols-2" data-editable="array" data-prop="items">
        {items.map((item) => (
          <li class="flex gap-3 border-t border-white/12 py-4 text-sm leading-6 text-white/78" data-editable="array-item">
            <span class="text-champagne" aria-hidden="true">—</span>
            <span data-editable="text" data-type="text" data-prop="text">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
    <aside class="border border-white/15 bg-white/[0.06] p-7 shadow-deep backdrop-blur-sm sm:p-10 lg:p-12">
      <h3 class="font-serif text-4xl font-medium leading-none" data-editable="text" data-type="text" data-prop="aside.heading">
        {aside.heading}
      </h3>
      <p class="mt-5 text-sm leading-7 text-white/65" data-editable="text" data-type="text" data-prop="aside.body">
        {aside.body}
      </p>
      <div class="mt-7">
        <ButtonLink href={aside.href} label={aside.label} dataProp="aside.label" />
      </div>
    </aside>
  </div>
</section>
