---
import ButtonLink from '../ButtonLink.astro';
import ResponsiveImage from '../ResponsiveImage.astro';

interface Props {
  eyebrow?: string | null;
  heading: string;
  body?: string | null;
  image?: { src: string; alt: string } | null;
  primaryCta?: { label: string; href: string } | null;
  secondaryCta?: { label: string; href: string } | null;
}

const { eyebrow, heading, body, image, primaryCta, secondaryCta } = Astro.props;
---

<section class="estate-web-hero">
  <div class:list={['content-shell estate-web-hero-grid', image?.src && 'estate-web-hero-split']}>
    <div>
      {eyebrow && <p class="eyebrow" data-editable="text" data-type="text" data-prop="eyebrow">{eyebrow}</p>}
      <h1 data-editable="text" data-type="text" data-prop="heading">{heading}</h1>
      {body && <p class="editorial-copy mt-6 max-w-2xl" data-editable="text" data-type="text" data-prop="body">{body}</p>}
      {(primaryCta?.label || secondaryCta?.label) && (
        <div class="mt-8 flex flex-wrap items-center gap-4">
          {primaryCta?.label && <ButtonLink href={primaryCta.href} label={primaryCta.label} dataProp="primaryCta.label" />}
          {secondaryCta?.label && <ButtonLink href={secondaryCta.href} label={secondaryCta.label} variant="tertiary" dataProp="secondaryCta.label" />}
        </div>
      )}
    </div>
    {image?.src && <div class="estate-web-hero-image" data-editable="image" data-prop="image">
      <ResponsiveImage src={image.src} alt={image.alt} width={1536} height={1024}
        loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 50vw" class="h-full w-full object-cover" />
    </div>}
  </div>
</section>
