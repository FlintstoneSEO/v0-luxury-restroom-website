NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM=
# Explicit application origins. Use origins only: no path, query, or fragment.
PUBLIC_SITE_URL=https://www.signatureluxeevents.com
ADMIN_APP_URL=
CUSTOMER_WORKFLOW_URL=
# Legacy compatibility fallback during migration. New deployments should set
# the three explicit origins above.
NEXT_PUBLIC_APP_URL=
# GOOGLE_MAPS_API_KEY is server-only for distance calculations.
GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is browser-safe for client-side autocomplete.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_BUSINESS_PHONE=
# Admin users must have Supabase Auth user_metadata.is_admin = true.
