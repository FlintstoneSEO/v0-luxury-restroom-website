#!/usr/bin/env bash

# CloudCannon sources this hook before running its automatic `npm install`.
# Older site snapshots can still contain this unused React 17-only package,
# which makes npm 10 reject the dependency tree before the Astro build starts.
if node -e "const p=require('./package.json'); process.exit(p.dependencies?.['@reach/combobox'] ? 0 : 1)"; then
  echo "Removing obsolete @reach/combobox dependency before install..."
  npm pkg delete 'dependencies.@reach/combobox'
fi
