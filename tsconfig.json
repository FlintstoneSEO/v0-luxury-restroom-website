{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.d.ts",
    ".next-calendar-check/types/**/*.ts",
    ".next-calendar-check/dev/types/**/*.ts",
    ".next-pricing-fixture/build/types/**/*.ts",
    ".next-pricing-fixture/build/dev/types/**/*.ts",
    ".next-msu-webpack/types/**/*.ts",
    ".next-msu-webpack/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web",
    "apps/admin"
  ]
}
